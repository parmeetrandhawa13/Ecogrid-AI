# ==========================================================
# ECOGRID AI — Environment Variable Specification
# ==========================================================

# 1. Gemini AI API Key (Optional: Powers strategic executive synthesis)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# 2. Application Base URL
APP_URL="http://localhost:3000"

# 3. PostgreSQL Database Connection URL (Optional: Defaults to persistent filesystem storage)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://ecogrid:ecogrid_secure_pass@localhost:5432/ecogrid_db?schema=public"

# 4. Mapbox Public Access Token (Optional: Defaults to CartoDB Dark Matter / OpenStreetMap)
# When provided, switches Leaflet / Mapbox to high-resolution Mapbox Dark vector styling
VITE_MAPBOX_TOKEN=""

# 5. Environment & Port
NODE_ENV="production"
PORT=3000
